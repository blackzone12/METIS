<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Metis — Learning Companion</title>
<meta name="description" content="Metis learning companion with background webcam behavior analysis.">

<style>
:root{
  --bg:#f6f8f6;
  --text:#202c29;
  --muted:#596660;
  --border:#dce3de;
  --green:#246348;
  --green2:#dcefe4;
  --white:#fff
}

*{box-sizing:border-box}

body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif
}

button,input,textarea{font:inherit}
button{cursor:pointer}

.app{
  min-height:100vh;
  display:flex;
  max-width:1500px;
  margin:auto
}

.sidebar{
  width:256px;
  background:#fff;
  border-right:1px solid var(--border);
  padding:24px 20px;
  flex:none;
  display:flex;
  flex-direction:column
}

.brand{
  display:flex;
  gap:12px;
  align-items:center;
  margin-bottom:40px
}

.logo{
  width:44px;
  height:44px;
  border-radius:16px;
  background:var(--green);
  color:#fff;
  display:grid;
  place-items:center;
  font-size:22px
}

.brand b{font-size:20px}

.brand small{
  display:block;
  color:var(--muted);
  font-size:12px
}

.nav{
  display:grid;
  gap:8px
}

.nav button{
  border:0;
  background:transparent;
  text-align:left;
  padding:12px 16px;
  border-radius:16px;
  color:var(--muted);
  font-weight:600
}

.nav button.active,
.nav button:hover{
  background:var(--green2);
  color:#184936
}

.sidebottom{
  margin-top:auto
}

.sidebottom button{
  width:100%;
  border:0;
  background:transparent;
  text-align:left;
  padding:12px 16px;
  color:var(--muted);
  border-radius:16px
}

.main{
  min-width:0;
  flex:1
}

.top{
  position:sticky;
  top:0;
  z-index:20;
  border-bottom:1px solid var(--border);
  background:rgba(246,248,246,.95);
  backdrop-filter:blur(10px);
  padding:16px 32px
}

.toprow{
  display:flex;
  align-items:center;
  justify-content:space-between
}

.top h1{
  font-size:20px;
  margin:3px 0
}

.top p{
  margin:0;
  color:var(--muted);
  font-size:14px
}

.actions{
  display:flex;
  gap:8px
}

.iconbtn{
  height:40px;
  min-width:40px;
  border:1px solid var(--border);
  border-radius:999px;
  background:#fff;
  color:var(--muted);
  padding:0 12px
}

.content{
  padding:32px
}

.page{display:none}
.page.active{display:block}

.grid{
  display:grid;
  gap:20px
}

.hero-grid{
  grid-template-columns:1.5fr 1fr
}

.tools-grid{
  grid-template-columns:repeat(4,1fr)
}

.card{
  background:#fff;
  border:1px solid var(--border);
  border-radius:24px;
  box-shadow:0 8px 30px rgba(32,44,41,.05);
  padding:24px
}

.hero{
  overflow:hidden;
  padding:0
}

.hero-inner{
  display:grid;
  grid-template-columns:1.1fr .9fr
}

.hero-copy{
  padding:32px
}

.hero-art{
  min-height:250px;
  background:var(--green2);
  position:relative;
  display:grid;
  place-items:center
}

.circle{
  position:absolute;
  right:28px;
  top:28px;
  width:96px;
  height:96px;
  border-radius:50%;
  background:#f4c95d
}

.square{
  position:absolute;
  left:28px;
  bottom:28px;
  width:112px;
  height:112px;
  border-radius:30px;
  background:#79a9d1
}

.book{
  position:relative;
  background:rgba(255,255,255,.85);
  padding:24px;
  border-radius:24px;
  font-size:44px;
  box-shadow:0 8px 25px rgba(0,0,0,.1)
}

.pill{
  display:inline-block;
  background:var(--green2);
  color:#184936;
  padding:5px 12px;
  border-radius:999px;
  font-size:12px;
  font-weight:700
}

.hero h2{
  font-size:38px;
  line-height:1.15;
  margin:18px 0 10px
}

.muted{
  color:var(--muted);
  line-height:1.6
}

.btn{
  border:0;
  border-radius:16px;
  padding:12px 18px;
  font-weight:700
}

.primary{
  background:var(--green);
  color:#fff
}

.secondary{
  background:#fff;
  border:1px solid var(--border)
}

.row{
  display:flex;
  gap:10px;
  flex-wrap:wrap
}

.progress{
  height:8px;
  background:#dce3de;
  border-radius:999px;
  overflow:hidden
}

.progress i{
  display:block;
  height:100%;
  background:var(--green);
  border-radius:999px
}

.timer{
  text-align:center;
  font-size:64px;
  font-weight:700;
  margin:30px 0 10px
}

.tool-icon{
  width:44px;
  height:44px;
  border-radius:16px;
  background:var(--green2);
  display:grid;
  place-items:center;
  font-size:21px
}

.card h3{
  margin:16px 0 6px
}

.linkbtn{
  border:0;
  background:transparent;
  color:var(--green);
  font-weight:700;
  padding:0;
  margin-top:15px
}

.flash{
  display:grid;
  gap:15px
}

.flash .question{
  font-size:22px;
  font-weight:700
}

.answer{
  padding:16px;
  background:var(--green2);
  border-radius:16px
}

.lesson-list{
  display:grid;
  gap:12px
}

.lesson{
  display:flex;
  justify-content:space-between;
  align-items:center;
  border:1px solid var(--border);
  border-radius:18px;
  padding:18px;
  background:#fff
}

.notes textarea{
  width:100%;
  min-height:300px;
  border:1px solid var(--border);
  border-radius:18px;
  padding:16px;
  resize:vertical
}

#cameraVideo{
  display:none
}

.camera-status{
  font-size:12px;
  margin-top:8px;
  color:var(--muted)
}

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.65);
  z-index:1000;
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px
}

.modal.show{
  display:flex
}

.modalbox{
  width:min(900px,100%);
  background:#fff;
  border-radius:24px;
  overflow:hidden;
  box-shadow:0 30px 100px rgba(0,0,0,.35)
}

.modalhead{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:18px 22px;
  border-bottom:1px solid var(--border)
}

.preview{
  background:#101513;
  aspect-ratio:16/9;
  display:grid;
  place-items:center;
  position:relative
}

.preview video{
  width:100%;
  height:100%;
  object-fit:cover;
  transform:scaleX(-1)
}

.modalfoot{
  padding:18px 22px;
  display:flex;
  justify-content:space-between;
  align-items:center
}

.badges{
  display:flex;
  gap:8px;
  flex-wrap:wrap
}

.badge{
  background:var(--green2);
  color:#184936;
  border-radius:999px;
  padding:7px 10px;
  font-size:12px;
  font-weight:700
}

.warning{
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:2147483647;
  display:none;
  justify-content:center;
  padding:20px;
  pointer-events:none
}

.warning.show{
  display:flex
}

.warningbox{
  width:min(720px,100%);
  background:#fffbeb;
  border:3px solid #facc15;
  border-radius:24px;
  padding:20px 24px;
  box-shadow:0 20px 60px rgba(0,0,0,.25);
  pointer-events:auto
}

.warningbox.red{
  background:#fef2f2;
  border-color:#f87171
}

.warningbox.purple{
  background:#faf5ff;
  border-color:#c084fc
}

.warningbox.orange{
  background:#fff7ed;
  border-color:#fb923c
}

.warningrow{
  display:flex;
  gap:15px;
  align-items:flex-start
}

.warningicon{
  font-size:30px;
  background:#fff;
  padding:12px;
  border-radius:16px
}

.warningtext{
  flex:1
}

.warningtext small{
  font-weight:800;
  letter-spacing:.12em;
  text-transform:uppercase;
  opacity:.6
}

.warningtext h2{
  margin:4px 0 7px
}

.warningtext p{
  margin:0;
  opacity:.8;
  line-height:1.5
}

.dismiss{
  border:0;
  border-radius:999px;
  background:#fff;
  padding:8px 12px;
  font-weight:700
}

.toast{
  position:fixed;
  right:20px;
  bottom:20px;
  background:#202c29;
  color:#fff;
  padding:13px 16px;
  border-radius:14px;
  z-index:2147483646;
  display:none;
  box-shadow:0 10px 30px rgba(0,0,0,.2)
}

.permission{
  position:fixed;
  left:20px;
  bottom:20px;
  background:#fff;
  border:1px solid var(--border);
  border-radius:16px;
  padding:14px 16px;
  z-index:2147483645;
  box-shadow:0 10px 30px rgba(0,0,0,.15);
  max-width:360px;
  display:none
}

@media(max-width:1000px){
  .sidebar{display:none}
  .hero-grid,.tools-grid{
    grid-template-columns:1fr 1fr
  }
  .content{padding:20px}
  .top{padding:14px 20px}
}

@media(max-width:650px){
  .hero-grid,.tools-grid{
    grid-template-columns:1fr
  }

  .hero-inner{
    grid-template-columns:1fr
  }

  .hero-art{
    min-height:180px
  }

  .hero h2{
    font-size:30px
  }

  .timer{
    font-size:52px
  }

  .content{
    padding:14px
  }
}
</style>
</head>

<body>

<div class="app">

<aside class="sidebar">

  <div class="brand">
    <div class="logo">✦</div>
    <div>
      <b>Metis</b>
      <small>Learning companion</small>
    </div>
  </div>

  <nav class="nav">
    <button class="active" data-page="home">⌂ &nbsp; Home</button>
    <button data-page="lessons">📖 &nbsp; Lessons</button>
    <button data-page="notes">▤ &nbsp; Notes</button>
  </nav>

  <div class="sidebottom">
    <button onclick="toast('Settings are ready for customization.')">
      ⚙ &nbsp; Settings
    </button>

    <button onclick="toast('Need help? Start with the lesson guide.')">
      ? &nbsp; Help
    </button>
  </div>

</aside>

<main class="main">

<header class="top">

  <div class="toprow">

    <div>
      <p>Good morning</p>
      <h1>Ready to learn?</h1>
    </div>

    <div class="actions">

      <button class="iconbtn" onclick="syncDemo()">
        Sync Data
      </button>

      <button class="iconbtn" id="muteBtn" onclick="toggleMute()">
        🔊
      </button>

      <button class="iconbtn" onclick="toast('Profile settings opened.')">
        M
      </button>

    </div>

  </div>

</header>

<div class="content">

<section id="home" class="page active">

<div class="grid hero-grid">

  <div class="card hero">

    <div class="hero-inner">

      <div class="hero-copy">

        <span class="pill">
          ✦ Continue learning
        </span>

        <h2 id="selectedTitle">
          The Water Cycle
        </h2>

        <p class="muted">
          Pick up where you left off and keep your learning momentum going.
        </p>

        <div class="row" style="margin-top:22px">

          <button class="btn primary"
                  onclick="toast('Opening The Water Cycle')">
            ▶ Continue
          </button>

          <button class="btn secondary"
                  onclick="showPage('lessons')">
            View lesson
          </button>

        </div>

        <div style="margin-top:25px">

          <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:7px">
            <span class="muted">Progress</span>
            <b id="progressText">72%</b>
          </div>

          <div class="progress">
            <i id="progressBar" style="width:72%"></i>
          </div>

        </div>

      </div>

      <div class="hero-art">

        <div class="circle"></div>
        <div class="square"></div>
        <div class="book">📖</div>

      </div>

    </div>

  </div>

  <div class="card">

    <div style="display:flex;justify-content:space-between">

      <div>
        <p class="muted" style="margin:0;font-size:14px">
          Focus timer
        </p>

        <h3 style="font-size:20px;margin-top:4px">
          Pomodoro
        </h3>
      </div>

      <span style="font-size:24px;color:var(--green)">
        ◷
      </span>

    </div>

    <div class="timer" id="timer">
