<!-- MediaPipe -->
<script type="module">

import {
  FaceLandmarker,
  FilesetResolver
} from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1/+esm";

const video =
  document.getElementById("cameraVideo");

const preview =
  document.getElementById("previewVideo");

let stream = null;
let landmarker = null;
let modelReady = false;
let dismissed = false;
let lastDetection = 0;

let distractionMs = 0;
let fatigueMs = 0;
let mouthMs = 0;

let lastFrame = performance.now();

const state = {
  isSquinting:false,
  isConfused:false,
  isDistracted:false,
  isFatigued:false,
  isReadingAloud:false
};

const $ = id =>
  document.getElementById(id);

function setStatus(text){

  $("cameraStatus").textContent = text;
  $("modalStatus").textContent = text;

}

async function startCamera(){

  if(stream) return;

  if(!navigator.mediaDevices?.getUserMedia){

    setStatus(
      "Camera is not supported in this browser."
    );

    return;
  }

  try{

    stream =
      await navigator.mediaDevices.getUserMedia({
        video:{
          facingMode:"user"
        },
        audio:false
      });

    video.srcObject = stream;

    await video.play().catch(()=>{});

    setStatus(
      "Camera active • background analysis running"
    );

    preview.srcObject = stream;

    await preview.play().catch(()=>{});

    $("permission").style.display =
      "none";

  }
  catch(e){

    console.error(e);

    setStatus(
      e.name === "NotAllowedError"
        ? "Camera permission denied. Allow camera access and reload."
        : "Camera could not be started."
    );

    $("permission").style.display =
      "block";
  }

}

async function startModel(){

  try{

    const resolver =
      await FilesetResolver.forVisionTasks(
        "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1/wasm"
      );

    landmarker =
      await FaceLandmarker.createFromOptions(
        resolver,
        {
          baseOptions:{
            modelAssetPath:
              "https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task",

            delegate:"GPU"
          },

          outputFaceBlendshapes:true,
          runningMode:"VIDEO",
          numFaces:1
        }
      );

    modelReady = true;

    $("modelBadge").textContent =
      "Model: ready";

    setStatus(
      "Camera active • MediaPipe analysis running"
    );

    requestAnimationFrame(loop);

  }
  catch(e){

    console.error(e);

    $("modelBadge").textContent =
      "Model: unavailable";

    setStatus(
      "Camera active • AI model failed to load"
    );

  }

}

function score(result,name){

  return (
    result
      .faceBlendshapes?.[0]
      ?.categories
      ?.find(
        c => c.categoryName === name
      )
      ?.score || 0
  );

}

function loop(now){

  if(
    !modelReady ||
    !stream ||
    video.readyState < 2
  ){

    requestAnimationFrame(loop);
    return;

  }

  if(
    now - lastDetection < 100
  ){

    requestAnimationFrame(loop);
    return;

  }

  const elapsed =
    Math.min(
      500,
      now - lastFrame
    );

  lastFrame = now;
  lastDetection = now;

  try{

    const result =
      landmarker.detectForVideo(
        video,
        performance.now()
      );

    const hasFace =
      !!result.faceBlendshapes?.length;

    if(!hasFace){

      distractionMs =
        Math.max(
          0,
          distractionMs - elapsed
        );

      fatigueMs =
        Math.max(
          0,
          fatigueMs - elapsed
        );

      mouthMs =
        Math.max(
          0,
          mouthMs - elapsed
        );

      Object.assign(
        state,
        {
          isSquinting:false,
          isConfused:false,
          isReadingAloud:false,
          isDistracted:
            distractionMs >= 2000,
          isFatigued:
            fatigueMs >= 1500
        }
      );

    }
    else{

      /*
       * Squint detection
       */
      const squint =
        score(
          result,
          "eyeSquintLeft"
        ) > .4 &&
        score(
          result,
          "eyeSquintRight"
        ) > .4;

      /*
       * Confusion detection
       */
      const confused =
        score(
          result,
          "browDownLeft"
        ) > .5 &&
        score(
          result,
          "browDownRight"
        ) > .5;

      /*
       * Looking away
       */
      const lookAway =
        Math.max(
          score(result,"eyeLookOutLeft"),
          score(result,"eyeLookInLeft"),
          score(result,"eyeLookOutRight"),
          score(result,"eyeLookInRight")
        ) > .6;

      /*
       * Blink / fatigue
       */
      const blink =
        score(
          result,
          "eyeBlinkLeft"
        ) > .7 ||
        score(
          result,
          "eyeBlinkRight"
        ) > .7;

      /*
       * Mouth movement
       */
      const mouth =
        score(
          result,
          "jawOpen"
        ) > .15 ||
        score(
          result,
          "mouthFunnel"
        ) > .2 ||
        score(
          result,
          "mouthPucker"
        ) > .2;

      /*
       * Accumulate distraction
       */
      distractionMs =
        lookAway
          ? distractionMs + elapsed
          : Math.max(
              0,
              distractionMs - elapsed * .75
            );

      /*
       * Accumulate fatigue
       */
      fatigueMs =
        blink
          ? fatigueMs + elapsed
          : Math.max(
              0,
              fatigueMs - elapsed
            );

      /*
       * Accumulate mouth movement
       */
      mouthMs =
        mouth
          ? mouthMs + elapsed
          : Math.max(
              0,
              mouthMs - elapsed
            );

      Object.assign(
        state,
        {
          isSquinting:squint,
          isConfused:confused,
          isDistracted:
            distractionMs >= 2000,
          isFatigued:
            fatigueMs >= 1500,
          isReadingAloud:
            mouthMs >= 1000
        }
      );

    }

    updateWarning();

  }
  catch(e){

    console.error(e);

  }

  requestAnimationFrame(loop);

}

function updateWarning(){

  let warning = null;

  /*
   * Priority:
   * 1. Squinting
   * 2. Distraction
   * 3. Fatigue
   * 4. Confusion
   */

  if(state.isSquinting){

    warning = [
      "👁️",
      "Vision Strain Detected",
      "You appear to be squinting. Consider adjusting your screen or taking a short break.",
      "yellow"
    ];

  }

  else if(state.isDistracted){

    warning = [
      "👀",
      "You Seem Distracted",
      "Try bringing your attention back to your lesson.",
      "red"
    ];

  }

  else if(state.isFatigued){

    warning = [
      "😴",
      "Fatigue Detected",
      "You may benefit from taking a short break before continuing.",
      "purple"
    ];

  }

  else if(state.isConfused){

    warning = [
      "💡",
      "Possible Confusion Detected",
      "Let's slow down and break the concept into smaller parts.",
      "orange"
    ];

  }

  if(!warning){

    $("warning").classList.remove(
      "show"
    );

    dismissed = false;

    return;
  }

  if(dismissed) return;

  $("warningIcon").textContent =
    warning[0];

  $("warningTitle").textContent =
    warning[1];

  $("warningMessage").textContent =
    warning[2];

  $("warningBox").className =
    "warningbox " +
    (
      warning[3] === "yellow"
        ? ""
        : warning[3]
    );

  $("warning").classList.add(
    "show"
  );

}

window.dismissWarning = () => {

  dismissed = true;

  $("warning").classList.remove(
    "show"
  );

};

window.openCamera = () => {

  $("cameraModal").classList.add(
    "show"
  );

  preview.srcObject = stream;

  preview.play().catch(()=>{});

};

window.closeCamera = () => {

  /*
   * IMPORTANT:
   * Closing preview does NOT stop
   * the global camera stream.
   */

  $("cameraModal").classList.remove(
    "show"
  );

};

window.retryCamera = startCamera;

/*
 * Automatically start camera and AI
 * when the page loads.
 */
startCamera();
startModel();

</script>

<script>

/*
 * -----------------------------
 * Lessons
 * -----------------------------
 */

const lessons = [

  [
    "The Water Cycle",
    "Science",
    "12 min",
    72
  ],

  [
    "Fractions & Decimals",
    "Mathematics",
    "18 min",
    45
  ],

  [
    "Photosynthesis",
    "Biology",
    "15 min",
    20
  ]

];

/*
 * -----------------------------
 * Flashcards
 * -----------------------------
 */

const cards = [

  [
    "What is evaporation?",
    "Evaporation is the process where liquid water changes into water vapour because of heat."
  ],

  [
    "What is condensation?",
    "Condensation happens when water vapour cools and changes back into tiny liquid water droplets."
  ],

  [
    "What is precipitation?",
    "Precipitation is water falling from clouds to Earth's surface as rain, snow, sleet, or hail."
  ]

];

let card = 0;
let showAns = false;

const tips = [

  "Break difficult material into small pieces and explain each piece in your own words.",

  "Use the Feynman Technique: Try teaching the concept to a 6-year-old to find gaps in your understanding.",

  "Space out your studying over several days rather than cramming. This builds stronger neural pathways.",

  "Use mnemonic devices and visual associations to connect new facts to things you already know.",

  "Test yourself frequently instead of just re-reading. Active recall forces your brain to retrieve information."

];

let tip = 0;

/*
 * -----------------------------
 * Pomodoro
 * -----------------------------
 */

let seconds = 1500;
let running = false;
let timerInt = null;

/*
 * Lesson audio mute state.
 * This is NOT microphone mute.
 */

let muted = false;


/*
 * -----------------------------
 * Navigation
 * -----------------------------
 */

function showPage(id){

  document
    .querySelectorAll(".page")
    .forEach(
      page =>
        page.classList.toggle(
          "active",
          page.id === id
        )
    );

  document
    .querySelectorAll(".nav button")
    .forEach(
      button =>
        button.classList.toggle(
          "active",
          button.dataset.page === id
        )
    );

}

document
  .querySelectorAll(".nav button")
  .forEach(
    button => {

      button.onclick = () =>
        showPage(
          button.dataset.page
        );

    }
  );


/*
 * -----------------------------
 * Toast
 * -----------------------------
 */

function toast(message){

  const element =
    document.getElementById("toast");

  element.textContent =
    message;

  element.style.display =
    "block";

  clearTimeout(
    window._tt
  );

  window._tt =
    setTimeout(
      () =>
        element.style.display =
          "none",
      2500
    );

}


/*
 * -----------------------------
 * Flashcards
 * -----------------------------
 */

function renderCards(){

  document.getElementById(
    "question"
  ).textContent =
    cards[card][0];

  document.getElementById(
    "answer"
  ).textContent =
    cards[card][1];

  document.getElementById(
    "answer"
  ).style.display =
    showAns
      ? "block"
      : "none";

}

function toggleAnswer(){

  showAns = !showAns;

  renderCards();

}

function nextCard(){

  card =
    (card + 1) %
    cards.length;

  showAns = false;

  renderCards();

}

function prevCard(){

  card =
    (card + cards.length - 1) %
    cards.length;

  showAns = false;

  renderCards();

}


/*
 * -----------------------------
 * Lessons
 * -----------------------------
 */

function renderLessons(){

  document.getElementById(
    "lessonList"
  ).innerHTML =

    lessons
      .map(
        (lesson,index) => `

          <div class="lesson">

            <div>

              <b>${lesson[0]}</b>

              <div class="muted">
                ${lesson[1]} • ${lesson[2]}
              </div>

            </div>

            <button
              class="btn primary"
              onclick="selectLesson(${index})">
              Study
            </button>

          </div>

        `
      )
      .join("");

}

function selectLesson(index){

  document.getElementById(
    "selectedTitle"
  ).textContent =
    lessons[index][0];

  document.getElementById(
    "progressText"
  ).textContent =
    lessons[index][3] + "%";

  document.getElementById(
    "progressBar"
  ).style.width =
    lessons[index][3] + "%";

  showPage("home");

  toast(
    "Selected " +
    lessons[index][0]
  );

}


/*
 * -----------------------------
 * Checklist
 * -----------------------------
 */

function renderChecklist(){

  const items = [

    "Read the lesson summary",
    "Complete the flashcards",
    "Answer the practice questions",
    "Review your mistakes"

  ];

  document.getElementById(
    "checklist"
  ).innerHTML =

    items
      .map(
        item => `

          <label
            style="
              display:block;
              padding:12px 0;
              border-bottom:1px solid var(--border)
            "
          >

            <input
              type="checkbox"
              onchange="
                this.parentElement.style.opacity =
                this.checked ? .55 : 1
              "
            >

            ${item}

          </label>

        `
      )
      .join("");

}


/*
 * -----------------------------
 * Study Tips
 * -----------------------------
 */

function nextTip(){

  tip =
    (tip + 1) %
    tips.length;

  document.getElementById(
    "tip"
  ).textContent =
    tips[tip];

}


/*
 * -----------------------------
 * Pomodoro
 * -----------------------------
 */

function toggleTimer(){

  running = !running;

  document.getElementById(
    "timerBtn"
  ).textContent =
    running
      ? "❚❚ Pause"
      : "▶ Start";

  document.getElementById(
    "timerStatus"
  ).textContent =
    running
      ? "Stay focused"
      : "Ready when you are";

  if(running && !timerInt){

    timerInt =
      setInterval(
        () => {

          if(seconds > 0){

            seconds--;

          }
          else{

            running = false;

            clearInterval(
              timerInt
            );

            timerInt = null;

          }

          renderTimer();

        },
        1000
      );

  }

  if(!running){

    clearInterval(
      timerInt
    );

    timerInt = null;

  }

}

function resetTimer(){

  seconds = 1500;

  running = false;

  clearInterval(
    timerInt
  );

  timerInt = null;

  document.getElementById(
    "timerBtn"
  ).textContent =
    "▶ Start";

  document.getElementById(
    "timerStatus"
  ).textContent =
    "Ready when you are";

  renderTimer();

}

function renderTimer(){

  document.getElementById(
    "timer"
  ).textContent =

    String(
      Math.floor(seconds / 60)
    ).padStart(2,"0")

    + ":" +

    String(
      seconds % 60
    ).padStart(2,"0");

}


/*
 * -----------------------------
 * Lesson audio
 * -----------------------------
 */

function toggleMute(){

  muted = !muted;

  document.getElementById(
    "muteBtn"
  ).textContent =
    muted
      ? "🔇"
      : "🔊";

}

function speakLesson(){

  if(muted){

    toast(
      "Audio is muted."
    );

    return;

  }

  speechSynthesis.cancel();

  const text =
    new SpeechSynthesisUtterance(
      "The water cycle includes evaporation, condensation, precipitation, and collection. Keep studying at your own pace."
    );

  speechSynthesis.speak(text);

}


/*
 * -----------------------------
 * Demo sync
 * -----------------------------
 */

function syncDemo(){

  toast(
    "Local study data is already saved in this browser. Backend sync requires a server."
  );

}


/*
 * -----------------------------
 * Notes
 * -----------------------------
 */

function saveNotes(){

  localStorage.setItem(
    "metis-notes",
    document.getElementById(
      "notesText"
    ).value
  );

  toast(
    "Notes saved locally."
  );

}


/*
 * -----------------------------
 * Browser Dictation
 * -----------------------------
 */

function toggleDictation(){

  const SR =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  if(!SR){

    toast(
      "Speech recognition is not supported in this browser."
    );

    return;

  }

  if(window._rec){

    window._rec.stop();

    window._rec = null;

    document.getElementById(
      "dictationStatus"
    ).textContent = "";

    return;

  }

  const recognition =
    new SR();

  recognition.continuous = true;
  recognition.interimResults = true;
  recognition.lang = "en-IN";

  recognition.onresult = event => {

    let transcript = "";

    for(
      let i = event.resultIndex;
      i < event.results.length;
      i++
    ){

      transcript +=
        event.results[i][0].transcript;

    }

    document.getElementById(
      "dictationStatus"
    ).textContent =
      transcript;

  };

  recognition.onerror = () => {

    toast(
      "Dictation could not start."
    );

  };

  recognition.onend = () => {

    window._rec = null;

  };

  window._rec =
    recognition;

  recognition.start();

  document.getElementById(
    "dictationStatus"
  ).textContent =
    "Listening…";

}


/*
 * -----------------------------
 * Initialise application
 * -----------------------------
 */

function init(){

  renderCards();

  renderLessons();

  renderChecklist();

  renderTimer();

  document.getElementById(
    "notesText"
  ).value =
    localStorage.getItem(
      "metis-notes"
    ) || "";

}

init();

</script>

</body>
